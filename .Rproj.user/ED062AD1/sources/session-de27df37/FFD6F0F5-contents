title: "Drilldown avec echarts4r"
output: html_document
---
  
```{r setup, include=FALSE}
library(echarts4r)
library(dplyr)
library(htmltools)
library(htmlwidgets)
library(jsonlite)

df <- data.frame(
  Region = rep(c("Europe", "Amérique", "Asie"), each = 3),
  Produit = rep(c("Produit A", "Produit B", "Produit C"), 3),
  CA = c(
    120, 80, 100,
    90, 150, 60,
    70, 110, 130
  )
)

# Agrégation du niveau 1
df_region <- df %>%
  group_by(Region) %>%
  summarise(CA = sum(CA), .groups = "drop")

# Données du niveau 2
details <- split(df, df$Region)

details_json <- toJSON(
  lapply(details, function(x) {
    list(
      categories = as.character(x$Produit),
      values = as.numeric(x$CA)
    )
  }),
  auto_unbox = TRUE
)

# Graphique initial
p <- df_region %>%
  e_charts(Region) %>%
  e_bar(CA, name = "Chiffre d'affaires") %>%
  e_title(text = "Niveau 1 — CA par région") %>%
  e_tooltip(trigger = "axis") %>%
  e_x_axis(name = "Région") %>%
  e_y_axis(name = "CA")
```

```{r graphique, echo=FALSE}
tagList(
  tags$button(
    id = "back_drill",
    "← Retour aux régions",
    style = "margin-bottom: 12px; display: none;"
  ),
  
  onRender(
    p,
    sprintf(
      "
      function(el, x) {
        var chart = this;
        var details = %s;
        var back = document.getElementById('back_drill');
        var currentRegion = null;

        chart.on('click', function(params) {
          if (currentRegion !== null) return;
          if (!details[params.name]) return;

          currentRegion = params.name;
          var d = details[currentRegion];

          chart.setOption({
            title: {
              text: 'Niveau 2 — ' + currentRegion
            },
            xAxis: {
              type: 'category',
              name: 'Produit',
              data: d.categories
            },
            yAxis: {
              type: 'value',
              name: 'CA'
            },
            series: [{
              name: 'Chiffre d’affaires',
              type: 'bar',
              data: d.values
            }]
          });

          back.style.display = 'inline-block';
        });

        back.addEventListener('click', function() {
          currentRegion = null;

          chart.setOption({
            title: {
              text: 'Niveau 1 — CA par région'
            },
            xAxis: {
              type: 'category',
              name: 'Région',
              data: %s
            },
            yAxis: {
              type: 'value',
              name: 'CA'
            },
            series: [{
              name: 'Chiffre d’affaires',
              type: 'bar',
              data: %s
            }]
          });

          back.style.display = 'none';
        });
      }
      ",
      details_json,
      toJSON(as.character(df_region$Region), auto_unbox = FALSE),
      toJSON(as.numeric(df_region$CA), auto_unbox = FALSE)
    )
  )
)
```
