```{r page}
kpi <- function(value, label, note = "") div(class = "kpi", div(class = "kpi-value", value), div(class = "kpi-label", label), div(class = "kpi-note", note))
imp_p <- sum(flows$VALUE[flows$FLOW == "IMPORT"]); exp_p <- sum(flows$VALUE[flows$FLOW == "EXPORT"])
div(class = "kpi-row",
    kpi(fmt_eur(imp_p), sprintf("Imports from the %d partners", nrow(pts_p)), paste0(fmt_pct(imp_p / tot_of("IMPORT")), " of total imports")),
    kpi(fmt_eur(exp_p), sprintf("Exports to the %d partners", nrow(pts_p)), paste0(fmt_pct(exp_p / tot_of("EXPORT")), " of total exports")),
    kpi(paste0(if_else(exp_p - imp_p >= 0, "+", "−"), fmt_eur(abs(exp_p - imp_p))), "Balance trade of goods with the partners", sprintf("exports / imports = %.2f", exp_p / imp_p)),
    kpi(prod_name, "Product", if (PROD == "TOTAL") "" else paste("HS2 chapter", PROD)))
div(class = "card-box", div(class = "card-title", sprintf("Trade flows · %s ↔ %s · %d", params$reporter, paste(pts_p$NAME, collapse = ", "), yr)),
    div(class = "card-sub", "Arrow width = value · blue arrows point into Luxembourg (imports), orange arrows point to the partner (exports) · label = value and share of the world total · hover an arrow for the details"),
    p)
tbl <- flows %>% select(NAME, FLOW, VALUE, SHARE) %>%
  pivot_wider(names_from = FLOW, values_from = c(VALUE, SHARE)) %>%
  transmute(Partner = NAME, Imports = fmt_eur(VALUE_IMPORT), `Share of imports` = fmt_pct(SHARE_IMPORT),
            Exports = fmt_eur(VALUE_EXPORT), `Share of exports` = fmt_pct(SHARE_EXPORT),
            `Balance trade of goods` = paste0(if_else(VALUE_EXPORT - VALUE_IMPORT >= 0, "+", "−"), fmt_eur(abs(VALUE_EXPORT - VALUE_IMPORT)))) %>%
  arrange(desc(Imports))
div(class = "card-box", div(class = "card-title", "Values behind the arrows"),
    HTML(paste(knitr::kable(tbl, format = "html", align = c("l", "r", "r", "r", "r", "r"), table.attr = "class='table table-sm'"), collapse = "\n")))
