```{r arrows}
# ---- Geometry of the arrows -----------------------------------------------------------------------
# Work in a locally flat frame (x = lon * cos(lat0), y = lat) so that offsets and arrowheads keep
# their shape, then convert back to lon / lat for scattergeo. Each flow is a quadratic Bézier curve
# bent to one side of the straight line (imports on one side, exports on the other) so that the two
# directions never overlap; the arrowhead is a small filled triangle at the end of the curve.
lat0 <- LU$LAT; kx <- cos(lat0 * pi / 180)
to_xy <- function(lon, lat) cbind(x = lon * kx, y = lat)
to_ll <- function(xy) cbind(LON = xy[, 1] / kx, LAT = xy[, 2])

bezier <- function(p0, p1, side, n = 40, bend = 0.22) {
  v <- p1 - p0; L <- sqrt(sum(v^2)); nrm <- c(-v[2], v[1]) / L          # unit normal
  c0 <- (p0 + p1) / 2 + side * bend * L * nrm                            # control point
  t <- seq(0, 1, length.out = n)
  pts <- cbind((1 - t)^2 * p0[1] + 2 * (1 - t) * t * c0[1] + t^2 * p1[1],
               (1 - t)^2 * p0[2] + 2 * (1 - t) * t * c0[2] + t^2 * p1[2])
  list(pts = pts, L = L, nrm = nrm * side, at = function(u) pts[max(1, round(u * n)), ])
}
arrow_head <- function(pts, size) {
  tip <- pts[nrow(pts), ]; prev <- pts[nrow(pts) - 2, ]
  d <- tip - prev; d <- d / sqrt(sum(d^2)); nrm <- c(-d[2], d[1])
  base <- tip - d * size
  tri <- rbind(tip, base + nrm * size * 0.55, base - nrm * size * 0.55)
  # plotly draws geo polygons with d3-geo: the ring must run clockwise (lon east, lat north),
  # otherwise the fill covers the whole sphere except the triangle
  area <- sum(tri[, 1] * c(tri[-1, 2], tri[1, 2]) - c(tri[-1, 1], tri[1, 1]) * tri[, 2]) / 2
  if (area > 0) tri <- tri[3:1, ]
  rbind(tri, tri[1, ])
}

vmax <- max(flows$VALUE)
width_of <- function(v) 2 + (params$max_width - 2) * sqrt(v / vmax)        # px, sqrt so small flows stay visible
head_of  <- function(v) 0.12 + 0.32 * sqrt(v / vmax)                          # in degrees of latitude (map units)

p <- plot_geo()
labels <- list()
for (i in seq_len(nrow(flows))) {
  f <- flows[i, ]
  P <- to_xy(f$LON, f$LAT)[1, ]; R <- to_xy(LU$LON, LU$LAT)[1, ]
  # imports run partner -> reporter, exports reporter -> partner; opposite sides of the line
  if (f$FLOW == "IMPORT") { b <- bezier(P, R, side = +1) } else { b <- bezier(R, P, side = +1) }
  # shorten the curve so the head does not sit on the marker
  pts <- b$pts[1:(nrow(b$pts) - 2), ]
  ll <- to_ll(pts); hd <- to_ll(arrow_head(pts, head_of(f$VALUE)))
  col <- FLOW_COLORS[[f$FLOW]]
  hover <- sprintf("<b>%s</b> · %s<br>%s: %s<br>%s of %s's total %s", f$NAME, prod_name, FLOW_LABELS[[f$FLOW]], fmt_eur(f$VALUE), fmt_pct(f$SHARE), params$reporter, tolower(FLOW_LABELS[[f$FLOW]]))
  p <- p %>%
    add_trace(type = "scattergeo", mode = "lines", lon = ll[, "LON"], lat = ll[, "LAT"],
              line = list(color = rgba(col, 0.75), width = width_of(f$VALUE)), hoverinfo = "text", text = hover,
              name = paste(f$NAME, FLOW_LABELS[[f$FLOW]]), showlegend = FALSE) %>%
    add_trace(type = "scattergeo", mode = "lines", lon = hd[, "LON"], lat = hd[, "LAT"], fill = "toself", fillcolor = col,
              line = list(color = col, width = 1), hoverinfo = "skip", showlegend = FALSE)
  # label near the partner end (60 % of the way from the reporter), pushed outward on the curve's own side
  lab_xy <- (if (f$FLOW == "IMPORT") b$at(0.38) else b$at(0.62)) + b$nrm * (0.10 * b$L + 0.45)
  mid <- to_ll(matrix(lab_xy, nrow = 1))
  labels[[i]] <- tibble(LON = mid[1, "LON"], LAT = mid[1, "LAT"], TXT = sprintf("%s · %s", fmt_eur(f$VALUE), fmt_pct(f$SHARE)), COL = col)
}
labels <- bind_rows(labels)

# Partner and reporter markers
pts_p <- flows %>% distinct(PARTNER, NAME, LON, LAT)
p <- p %>%
  add_trace(type = "scattergeo", mode = "markers+text", data = pts_p, lon = ~LON, lat = ~LAT, text = ~NAME, textposition = "bottom center",
            textfont = list(size = 12, color = COL_NAVY, family = FONT_FAMILY),
            marker = list(size = 10, color = "#FFFFFF", line = list(color = COL_NAVY, width = 2)), hoverinfo = "text", hovertext = ~NAME, showlegend = FALSE) %>%
  add_trace(type = "scattergeo", mode = "markers+text", lon = LU$LON, lat = LU$LAT, text = params$reporter, textposition = "top center",
            textfont = list(size = 13, color = COL_NAVY, family = FONT_FAMILY),
            marker = list(size = 14, color = COL_NAVY, line = list(color = "#FFFFFF", width = 2)), hoverinfo = "text",
            hovertext = sprintf("<b>%s</b><br>%s<br>Imports: %s · Exports: %s", params$reporter, prod_name, fmt_eur(tot_of("IMPORT")), fmt_eur(tot_of("EXPORT"))), showlegend = FALSE) %>%
  add_trace(type = "scattergeo", mode = "text", data = labels, lon = ~LON, lat = ~LAT, text = ~TXT, textfont = list(size = 11, color = ~COL, family = FONT_FAMILY),
            hoverinfo = "skip", showlegend = FALSE) %>%
  # legend entries
  add_trace(type = "scattergeo", mode = "lines", lon = c(NA, NA), lat = c(NA, NA), line = list(color = FLOW_COLORS[["IMPORT"]], width = 6), name = sprintf("Imports (into %s)", params$reporter)) %>%
  add_trace(type = "scattergeo", mode = "lines", lon = c(NA, NA), lat = c(NA, NA), line = list(color = FLOW_COLORS[["EXPORT"]], width = 6), name = sprintf("Exports (from %s)", params$reporter))

# Map window around the points drawn
lon_r <- range(c(flows$LON, LU$LON)); lat_r <- range(c(flows$LAT, LU$LAT))
pad_lon <- max(4.5, diff(lon_r) * 0.55); pad_lat <- max(1.2, diff(lat_r) * 0.18)   # wide window: room for the labels
p <- p %>%
  layout(
    geo = list(projection = list(type = "mercator"), showframe = FALSE, showcoastlines = TRUE, coastlinecolor = "#C9C4EC",
               showcountries = TRUE, countrycolor = "#C9C4EC", landcolor = "#EDF0F7", showocean = TRUE, oceancolor = "#FFFFFF",
               showlakes = FALSE, bgcolor = "rgba(0,0,0,0)", resolution = 50,
               lonaxis = list(range = lon_r + c(-pad_lon, pad_lon)), lataxis = list(range = lat_r + c(-pad_lat, pad_lat))),
    legend = list(orientation = "h", x = 0.5, xanchor = "center", y = -0.02, font = list(size = 12)),
    font = list(family = FONT_FAMILY, color = COL_NAVY), paper_bgcolor = "rgba(0,0,0,0)", hoverlabel = list(font = list(family = FONT_FAMILY)),
    margin = list(l = 0, r = 0, t = 10, b = 40)
  ) %>%
  config(displaylogo = FALSE, modeBarButtonsToRemove = c("lasso2d", "select2d"),
         topojsonURL = if (nzchar(params$topojson_url)) params$topojson_url else NULL)
p$height <- 600
