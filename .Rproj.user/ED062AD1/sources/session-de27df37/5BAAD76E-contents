```{r data}
if (exists("final_df", envir = globalenv(), inherits = FALSE)) {
  final_df <- get("final_df", envir = globalenv())
} else if (nzchar(params$data_path) && file.exists(params$data_path)) {
  final_df <- readRDS(params$data_path)
} else stop("final_df not found: run saveRDS(final_df, \"final_df.rds\") or render with envir = globalenv()")

yr <- params$year; PARTNERS <- unlist(params$partners); PROD <- params$product
raw <- final_df %>%
  transmute(PARTNER = ifelse(is.na(PARTNER_CODE), "NA", as.character(PARTNER_CODE)), PARTNER_LABEL, PRODUCT = as.character(PRODUCT_CODE),
            PRODUCT_LABEL, FLOW = toupper(FLOW_LABEL), TIME = as.integer(TIME), VALUE = as.numeric(VALUE_IN_EUROS)) %>%
  filter(!is.na(VALUE), TIME == yr, FLOW %in% names(FLOW_COLORS))

# Chapter: TOTAL when present, else the sum of the chapters
prod_rows <- function(d) if (PROD == "TOTAL" && !"TOTAL" %in% d$PRODUCT) d %>% filter(!PRODUCT %in% c("TOTAL")) %>%
  group_by(PARTNER, PARTNER_LABEL, FLOW) %>% summarise(VALUE = sum(VALUE), .groups = "drop") else d %>% filter(PRODUCT == PROD) %>% select(PARTNER, PARTNER_LABEL, FLOW, VALUE)
prod_name <- if (PROD == "TOTAL") "All products" else str_to_sentence(raw$PRODUCT_LABEL[raw$PRODUCT == PROD][1])

# World totals = Eurostat WORLD when present, else the sum of the partner countries
is_country <- function(code) str_detect(code, "^[A-Z]{2}$") & !str_detect(code, "^Q")
world <- prod_rows(raw %>% filter(PARTNER == "WORLD"))
tot <- if (nrow(world) > 0) world %>% group_by(FLOW) %>% summarise(TOTAL = sum(VALUE), .groups = "drop") else
  prod_rows(raw %>% filter(is_country(PARTNER))) %>% group_by(FLOW) %>% summarise(TOTAL = sum(VALUE), .groups = "drop")
tot_of <- function(fl) { v <- tot$TOTAL[tot$FLOW == fl]; if (length(v)) v else NA_real_ }

flows <- prod_rows(raw %>% filter(PARTNER %in% PARTNERS)) %>%
  group_by(PARTNER, FLOW) %>% summarise(VALUE = sum(VALUE), NAME = str_squish(str_remove(first(PARTNER_LABEL), "\\s*\\(.*$")), .groups = "drop") %>%
  mutate(SHARE = VALUE / if_else(FLOW == "IMPORT", tot_of("IMPORT"), tot_of("EXPORT"))) %>%
  left_join(COORDS, by = c("PARTNER" = "CODE"))
missing_coords <- unique(flows$PARTNER[is.na(flows$LON)])
if (length(missing_coords)) warning("No coordinates for: ", paste(missing_coords, collapse = ", "), " - add them to COORDS")
flows <- flows %>% filter(!is.na(LON))
LU <- COORDS %>% filter(CODE == params$reporter_code)
