# ---- reader: the colleague's Comext columns or the tidy columns of the Python pipeline ----
# the first existing path among the one given in params and the usual places next to this .Rmd
find_file <- function(path, names) {
  candidates <- unique(c(path, file.path("../data", names), file.path("data", names), names))
  hit <- candidates[file.exists(candidates)]
  if (length(hit)) return(hit[1])
  stop("File not found. Looked for:\n  ", paste(normalizePath(candidates, winslash = "/", mustWork = FALSE), collapse = "\n  "),
       "\n  (working folder while knitting: ", getwd(), ")",
       "\n  -> put the file in one of these places, or knit with params = list(data_lu = \"C:/full/path/final_df.rds\")", call. = FALSE)
}
read_trade <- function(path, reporter = NULL) {
  d <- if (grepl("\\.rds$", path, ignore.case = TRUE)) readRDS(path) else read.csv(path, colClasses = "character")
  d <- as.data.frame(d)
  names(d) <- tolower(names(d))
  pick <- function(...) { c <- intersect(c(...), names(d)); if (length(c)) d[[c[1]]] else NULL }
  cols <- list(
    partner = pick("partner_code", "partner"),
    product = pick("product_code", "product"),
    flow    = pick("flow_code", "flow"),
    period  = pick("time", "period", "time_period", "year"),
    value   = pick("value_in_euros", "value", "obs_value")
  )
  missing <- names(cols)[vapply(cols, is.null, logical(1))]
  if (length(missing)) stop("Column(s) not found in ", path, ": ", paste(missing, collapse = ", "), call. = FALSE)
  out <- as.data.frame(cols, stringsAsFactors = FALSE)
  rep <- pick("reporter_code", "reporter", "declarant", "geo")
  out$reporter <- if (!is.null(rep)) rep else if (!is.null(reporter)) reporter else stop("No reporter column in ", path, call. = FALSE)
  lab <- pick("partner_label", "partner_name")
  out$partner_name <- if (!is.null(lab)) sub("\\s*\\(.*$", "", lab) else NA_character_   # "Belgium (incl. ...)" -> "Belgium"
  if (!is.null(pick("indicator_code", "indicators"))) out <- out[pick("indicator_code", "indicators") == "VALUE_IN_EUROS", ]
  if (!is.null(pick("freq"))) out <- out[pick("freq") == "A", ]
  out %>%
    mutate(across(c(reporter, partner, product, flow, period), as.character), value = as.numeric(value)) %>%
    filter(!is.na(value), nchar(period) == 4)           # annual rows only ("2024", not "2024-03")
}
