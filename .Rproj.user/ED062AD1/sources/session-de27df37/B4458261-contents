    setHTML("dna-s-mix", n ? D.focusName + "'s " + f.word + " " + f.prep + " " + b(name(S.partner)) + " in " + S.year + " are led by " + b(/^[0-9]/.test(rs[0][0]) ? hs2(rs[0][0]) : rs[0][0]) +
      ": " + eur(rs[0][1]) + ", " + Math.round(100 * rs[0][2]) + " % of everything " + f.dir2 + " this country." : "");
  };

  function update() {
    var f = F[S.flow];
    setText("dna-year", S.year); setText("dna-flow", f.word); setText("dna-prep", f.prep); setText("dna-dir", f.dir);
    setText("dna-flow-cap", f.word.charAt(0).toUpperCase() + f.word.slice(1));
    var yl = document.getElementById("dna-year-label"); if (yl) yl.textContent = S.year;
    for (var k in W) if (U[k]) U[k](W[k]);
    U.kpi();
  }
  function init() {
    if (ready) return; ready = true;
    var flowSel = document.getElementById("dna-flow"), yr = document.getElementById("dna-year"), timer = null;
    flowSel.value = S.flow; yr.min = 0; yr.max = D.years.length - 1; yr.value = Math.max(0, D.years.indexOf(S.year));
    flowSel.addEventListener("change", function () { S.flow = flowSel.value; update(); });
    yr.addEventListener("input", function () {
      S.year = D.years[+yr.value]; var yl = document.getElementById("dna-year-label"); if (yl) yl.textContent = S.year;
      clearTimeout(timer); timer = setTimeout(update, 60);
    });
    document.getElementById("dna-prev").addEventListener("click", function () { if (+yr.value > 0) { yr.value = +yr.value - 1; S.year = D.years[+yr.value]; update(); } });
    document.getElementById("dna-next").addEventListener("click", function () { if (+yr.value < D.years.length - 1) { yr.value = +yr.value + 1; S.year = D.years[+yr.value]; update(); } });
    var picks = { "dna-twin": ["twin", "butterfly"], "dna-product": ["product", "picker"], "dna-pproduct": ["pproduct", "rank"], "dna-partner": ["partner", "mix"] };
    Object.keys(picks).forEach(function (id) {
      var sel = document.getElementById(id); if (!sel) return;
      sel.addEventListener("change", function () { S[picks[id][0]] = sel.value; if (W[picks[id][1]]) U[picks[id][1]](W[picks[id][1]]); });
    });
    update();
  }
  window.DNA = {
    register: function (name, el) { W[name] = el; if (ready && U[name]) U[name](el); },
    state: S, data: D
  };
