    var raw = Math.max(top, 1e-9) / 3.5, mag = Math.pow(10, Math.floor(Math.log(raw) / Math.LN10)), ks = [1, 2, 2.5, 5, 10];
    for (var i = 0; i < ks.length; i++) if (raw <= ks[i] * mag) return ks[i] * mag;
    return 10 * mag;
  }
  function redraw(el) { el.layout.datarevision = ++rev; Plotly.react(el, el.data, el.layout); }
  function setText(cls, txt) { var es = document.getElementsByClassName(cls); for (var i = 0; i < es.length; i++) es[i].textContent = txt; }
