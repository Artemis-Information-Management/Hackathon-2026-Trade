# nested lists  flow -> year -> ... -> small table, the shape stored in the page for the controls
nest <- function(df, keys, leaf = function(d) d) {
  if (!length(keys)) return(leaf(df))
  lapply(split(df, df[[keys[1]]], drop = TRUE), function(d) nest(d, keys[-1], leaf))
}
leaf_of <- function(x, ...) { for (k in c(...)) { x <- x[[k]]; if (is.null(x)) return(NULL) }; x }
# keep the n first rows of each group (rows are already ordered, column `row`), fold the rest into one row
fold_rows <- function(d, keys, n, sums) {
  head <- d %>% filter(row <= n)
  tail <- d %>% filter(row > n) %>% group_by(across(all_of(keys))) %>%
    summarise(product = other_label(n()), across(all_of(sums), sum), row = n + 1L, .groups = "drop")
  bind_rows(head, tail) %>% arrange(across(all_of(c(keys, "row"))))
}
