```{r data-twins, eval=has_eu}
# ---- twins: HS2 shares of each reporter's trade with the world, BOTH flows, ALL years ----
raw <- bind_rows(lu, eu %>% filter(reporter != focus))
# The TOTAL line and finer codes are dropped on purpose: counted as "one more product" they would
# inflate every similarity (indicators/similarity.py).
hs2 <- raw %>%
  filter(partner == "WORLD", nchar(product) == 2, value > 0) %>%
  group_by(flow, period, reporter, product) %>%
  summarise(value = sum(value), .groups = "drop")
if (!focus %in% hs2$reporter) stop("No rows with partner WORLD for ", focus, " in ", params$data_lu)
if (length(unique(hs2$reporter)) < 2) stop("Only one reporter in the data: nothing to compare Luxembourg with.")

shares <- hs2 %>% group_by(flow, period, reporter) %>% mutate(share = value / sum(value)) %>% ungroup() %>% select(-value)

# the universal table: every (flow, year) x other country x chapter, with 0 where a country has nothing,
# next to the focus country's share of the same chapter.
#   common = min(share, share_focus)  -> what the chapter adds to the similarity score
#   gap    = |share - share_focus|    -> how far the two countries are on this chapter
overlap <- shares %>%
  complete(nesting(flow, period), reporter, product, fill = list(share = 0)) %>%
  group_by(flow, period, reporter) %>% filter(sum(share) > 0) %>% ungroup()
focus_shares <- overlap %>% filter(reporter == focus) %>% select(flow, period, product, share_focus = share)
overlap <- overlap %>%
  filter(reporter != focus) %>%
  inner_join(focus_shares, by = c("flow", "period", "product")) %>%
  mutate(common = pmin(share, share_focus), gap = abs(share - share_focus))

# Finger-Kreinin: the sum of the common parts, ranked per flow x year
fk <- overlap %>% group_by(flow, period, reporter) %>% summarise(fk = sum(common), .groups = "drop") %>%
  mutate(name = country_name(reporter)) %>% arrange(flow, period, desc(fk), reporter)

# collapse_overlap(): per flow x year x country, the n_rows biggest chapters (focus + other), the rest folded
basket_all <- overlap %>% filter(share > 0 | share_focus > 0) %>%
  group_by(flow, period, reporter) %>% arrange(desc(share + share_focus), product, .by_group = TRUE) %>%
  mutate(row = row_number()) %>% ungroup() %>%
  fold_rows(c("flow", "period", "reporter"), params$n_rows, c("share_focus", "share", "common"))
# overlap_summary(): the three chapters that bring most points, and the biggest difference
top3_all <- overlap %>% filter(common > 0) %>% group_by(flow, period, reporter) %>%
  arrange(desc(common), product, .by_group = TRUE) %>% slice_head(n = 3) %>% ungroup()
gap_all <- overlap %>% group_by(flow, period, reporter) %>% arrange(desc(gap), product, .by_group = TRUE) %>% slice_head(n = 1) %>% ungroup()
# product_twins(): per flow x year x chapter, every other country sorted by gap (n_countries kept)
picker_all <- overlap %>% group_by(flow, period, product) %>% arrange(gap, reporter, .by_group = TRUE) %>%
  slice_head(n = params$n_countries) %>% ungroup()
products_all <- focus_shares %>% filter(share_focus > 0) %>% arrange(flow, period, desc(share_focus))
# common_matrix(): per flow x year, chapters x the 5 closest twins
heat_all <- lapply(split(fk, fk$flow), function(f) lapply(split(f, f$period), function(s) {
  top_codes <- head(s$reporter, 5)
  m <- overlap %>% filter(flow == s$flow[1], period == s$period[1], reporter %in% top_codes) %>%
    select(product, reporter, common) %>% pivot_wider(names_from = reporter, values_from = common, values_fill = 0)
  m <- m[, c("product", top_codes[top_codes %in% names(m)]), drop = FALSE]
  m <- m %>% mutate(total = rowSums(across(-product))) %>% filter(total > 0) %>% arrange(desc(total), product) %>% select(-total)
  if (nrow(m) > params$n_rows) {
    tail <- m[-(1:params$n_rows), ]
    m <- bind_rows(m[1:params$n_rows, ], c(list(product = other_label(nrow(tail))), as.list(colSums(tail[, -1]))))
  }
  list(cols = I(names(m)[-1]), rows = I(m$product), z = unname(as.matrix(m[, -1])))
}))
