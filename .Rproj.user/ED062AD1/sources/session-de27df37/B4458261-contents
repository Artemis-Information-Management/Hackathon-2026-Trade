  function eur(v) { return v >= 1e9 ? (v / 1e9).toFixed(1) + " bn \u20ac" : v >= 1e6 ? Math.round(v / 1e6) + " M \u20ac" : Math.round(v) + " \u20ac"; }
  function b(s) { return "<b>" + s + "</b>"; }
  function seq(n) { var a = []; for (var i = 1; i <= n; i++) a.push(i); return a; }
  function maxOf(a) { return a.length ? Math.max.apply(null, a) : 0; }
  function get(o) { for (var i = 1; i < arguments.length; i++) { if (o === null || o === undefined) return null; o = o[arguments[i]]; } return o === undefined ? null : o; }
