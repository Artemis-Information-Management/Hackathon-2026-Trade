# ---- 5. Data.frame final -----------------------------------------------------
dataset <- consolide |>
  select(SOURCE_FILE, FREQ_CODE, REPORTER_CODE, REPORTER_LABEL,
         PRODUCT_CODE, PRODUCT_LABEL, FLOW_CODE, FLOW_LABEL,
