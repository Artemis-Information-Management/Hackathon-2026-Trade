# Raw Eurostat downloads can be large; regenerate with scripts/fetch_data.py or re-export
data/raw/*
!data/raw/.gitkeep

# Processed parquet is committed on purpose (small, makes the app reproducible),
# but the R input scratch files are not
data/processed/r/_input_*

