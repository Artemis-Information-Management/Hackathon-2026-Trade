__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/

# R
.Rhistory
.RData
.Rproj.user/

# Secrets and local config
.env
.streamlit/secrets.toml

# OS / editors
.DS_Store
.vscode/
.idea/
